# Search provider selection: auto | tavily | brave
SEARCH_PROVIDER=auto

# Add at least one provider key.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional canonical URL used for metadata.
NEXT_PUBLIC_SITE_URL=

# Only used by automated end-to-end tests. Never enable in production.
E2E_MOCK_SEARCH=false
