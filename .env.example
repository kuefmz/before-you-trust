# Local development can use direct server-only values below.
# Production Amplify can load sensitive values from an encrypted SSM
# SecureString JSON parameter referenced by RUNTIME_SECRETS_PARAMETER.
RUNTIME_SECRETS_PARAMETER=

# Public-web search is fully self-hosted: SearXNG for broad discovery,
# with YaCy as an independent index/fallback. No paid search API key is required.
SEARCH_PROVIDER=auto
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_USERNAME=
SEARXNG_PASSWORD=
YACY_BASE_URL=http://localhost:8090
# global asks YaCy peers too; local searches only the configured node's own index.
YACY_RESOURCE=global
# Optional: use both values if your YaCy search endpoint requires Basic Auth.
YACY_USERNAME=
YACY_PASSWORD=

# Optional photo matching.
GOOGLE_VISION_API_KEY=

# Canonical site / public metadata.
# Keep indexing false on local/dev/staging. Set true only on the canonical
# production domain after the live retrieval benchmark and launch review pass.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_PRIVACY_EMAIL=

# External support link. Defaults to the production Buy Me a Coffee profile.
NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/jenifertabitaciuciukiss

# Google Analytics 4. The app defaults to the production measurement ID below.
# GA4 is blocked until the visitor explicitly allows analytics.
NEXT_PUBLIC_GA4_ID=G-MVDVBJJFQB

# Google Tag Manager. The app defaults to the production container below.
# GTM is blocked until the visitor explicitly allows analytics.
NEXT_PUBLIC_GTM_ID=GTM-TPGSP8XN

# Report storage + delivery.
# The Apps Script web-app endpoint is public and does not require a shared secret.
REPORT_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxe1s2hTRDF3m37UDcEHCj8Feb5iEDwjM82ZXizQ1sOgdZvJdNvkLbJsYi3FCJHA7Ml/exec

# Brevo is still optional for Share Your Story only.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Before You Trust
OWNER_NOTIFICATION_EMAIL=

AWS_REGION=eu-central-1

# Test-only. Never enable in production.
E2E_MOCK_SEARCH=false
E2E_MOCK_EMAIL=false
E2E_MOCK_IMAGE_SEARCH=false
