# Local development can use direct server-only values below.
# Production Amplify can load sensitive values from an encrypted SSM
# SecureString JSON parameter referenced by RUNTIME_SECRETS_PARAMETER.
RUNTIME_SECRETS_PARAMETER=

# Public-web search uses your own YaCy node. No third-party search API key is required.
# Local default: http://localhost:8090
SEARCH_PROVIDER=yacy
YACY_BASE_URL=http://localhost:8090
# global asks YaCy peers too; local searches only the configured node's own index.
YACY_RESOURCE=global
# Optional: use both values if your YaCy search endpoint requires Basic Auth.
YACY_USERNAME=
YACY_PASSWORD=

# Optional photo matching.
GOOGLE_VISION_API_KEY=

# Canonical site / public metadata.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Optional external support link. Hidden when unset.
NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=

# Optional Google Tag Manager. When unset, no analytics banner or Google tag loads.
# When set, GTM is blocked until the visitor explicitly allows analytics.
NEXT_PUBLIC_GTM_ID=

# Report storage + delivery.
# The Apps Script URL is non-secret; the secret must match the Apps Script
# Script Property named API_SECRET.
REPORT_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxe1s2hTRDF3m37UDcEHCj8Feb5iEDwjM82ZXizQ1sOgdZvJdNvkLbJsYi3FCJHA7Ml/exec
REPORT_APPS_SCRIPT_SECRET=

# Brevo is still optional for Share Your Story only.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Before You Trust
OWNER_NOTIFICATION_EMAIL=

AWS_REGION=eu-central-1

# Test-only. Never enable in production.
E2E_MOCK_SEARCH=false
E2E_MOCK_EMAIL=false
E2E_MOCK_IMAGE_SEARCH=false
