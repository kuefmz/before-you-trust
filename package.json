{
  "name": "before-you-trust",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run deploy:preflight && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "deploy:preflight": "node scripts/deployment-preflight.mjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@aws-sdk/client-ssm": "3.1121.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.24",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
